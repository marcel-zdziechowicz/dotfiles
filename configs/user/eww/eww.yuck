(defpoll sysinfo :interval "20h" "bash ~/.config/eww/scripts/get-sys-info.sh")
(defpoll diskinfo :interval "20h" "bash ~/.config/eww/scripts/get-disk-info.sh")
(defpoll proc_count :interval "20h" "ps -e --no-headers | wc -l")
;; TODO: performance i powersaving buttons 3x2

(defwidget info_widget []
	(box
		:class "widget"
		:orientation "vertical"
		(box
			:orientation "horizontal"
			:space-evenly false
			:spacing 14
			(label :class "info-lbl ip-lbl" :justify "left" :text "Local IP: ${sysinfo.ip}")
			(label :class "info-lbl net-lbl" :text "↓${formatbytes(round(EWW_NET.wlp0s29u1u6.NET_DOWN, 0))}/s ↑${formatbytes(round(EWW_NET.wlp0s29u1u6.NET_UP, 0))}/s")
			(label :class "info-lbl ping-lbl" :text "Ping: ${sysinfo.ping} ms")
		)
		(box
			:orientation "horizontal"
			:space-evenly false
			:spacing 14
			(label :class "info-lbl uptime-lbl" :text "⏱  Up: ${sysinfo.uptime}")
			(label :class "info-lbl proc-lbl" :text "Procesy: ${proc_count}")
			(label :class "info-lbl kernel-lbl" :text "Kernel: ${sysinfo.kernel}")
		)
		(box
			:orientation "horizontal"
			:space-evenly false
			:spacing 14
			(label :class "info-lbl ram-lbl" :text " RAM: ${sysinfo.ram_info}")
			(scale :class "bar ram-bar" :valign "center" :hexpand false :width 120 :active false :draw-value false :min 0 :max 100 :value {sysinfo.ram_usage})
		)
		(box
			:orientation "horizontal"
			:space-evenly false
			:spacing 14
			(label :class "info-lbl cpu-lbl" :text " CPU: ${sysinfo.cpu_temp}°C")
			(scale :class "bar cpu-bar" :valign "center" :hexpand false :width 120 :active false :draw-value false :min 0 :max 100 :value {sysinfo.cpu_usage})
		)
		(box
			:orientation "horizontal"
			:space-evenly false
			:spacing 14
			(label :class "info-lbl gpu-lbl" :text "󰢮 GPU: ${sysinfo.gpu_temp}°C")
			(scale :class "bar gpu-bar" :valign "center" :hexpand false :width 120 :active false :draw-value false :min 0 :max 100 :value {sysinfo.gpu_usage})
		)
		(box
			:orientation "horizontal"
			:space-evenly false
			:spacing 14
			(label :class "info-lbl disk-lbl" :text "💿 Disk: ${diskinfo.percent}% (${diskinfo.used_gb}/${diskinfo.total_gb}GB)")
			(scale :class "bar disk-bar" :valign "center" :hexpand false :width 120 :active false :draw-value false :min 0 :max 100 :value {diskinfo.percent})
		)
	)
)

